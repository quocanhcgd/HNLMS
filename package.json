{
  "name": "hnlms-workspace",
  "private": true,
  "engines": {
    "node": ">=20.12 <21"
  },
  "workspaces": [
    "apps/*",
    "worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@hnlms/web",
    "dev:web": "npm run dev --workspace=@hnlms/web",
    "dev:api": "npm run dev --workspace=@hnlms/api",
    "dev:worker": "npm run dev --workspace=@hnlms/worker",
    "build": "npm run build --workspace=@hnlms/web",
    "typecheck": "npm run typecheck --workspace=@hnlms/web && npm run typecheck --workspace=@hnlms/api && npm run typecheck --workspace=@hnlms/worker",
    "lint": "npm run lint --workspace=@hnlms/web",
    "test": "npm run test --workspace=@hnlms/api"
  }
}
