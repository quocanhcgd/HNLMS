{
  "name": "hnlms-workspace",
  "private": true,
  "packageManager": "npm@10.5.0",
  "engines": {
    "node": ">=20.19 <21"
  },
  "workspaces": [
    "apps/*",
    "worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@hnlms/web -- -p 3100",
    "dev:web": "npm run dev --workspace=@hnlms/web -- -p 3100",
    "dev:api": "npm run dev --workspace=@hnlms/api",
    "dev:worker": "npm run dev --workspace=@hnlms/worker",
    "build": "npm run build --workspace=@hnlms/web",
    "typecheck": "npm run typecheck --workspace=@hnlms/web && npm run typecheck --workspace=@hnlms/api && npm run typecheck --workspace=@hnlms/worker && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check \"apps/**/src/**/*.{ts,tsx,js,mjs,css,json,md}\" \"worker/src/**/*.{ts,js,json,md}\" \"packages/**/src/**/*.{ts,tsx,json,md}\" \"tests/**/*.{ts,tsx}\" \"*.{json,md,mjs}\" \"docs/development/**/*.{md,json}\"",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run apps/api/tests/contract",
    "test:authorization": "vitest run apps/api/tests/authorization tests/unit/authorization-matrix.test.ts",
    "test:migration": "vitest run apps/api/src/database/migration-smoke.test.ts tests/unit/migration-landing-content.test.ts tests/unit/t053-admission-schema.test.ts",
    "ci:secret-scan": "node scripts/ci-secret-scan.mjs",
    "ci:license-scan": "node scripts/ci-license-scan.mjs",
    "readiness:check": "node scripts/readiness-gate.mjs",
    "readiness:production": "node scripts/readiness-gate.mjs --production",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:services": "node scripts/check-local-services.mjs",
    "status:generate": "node scripts/update-project-status.mjs && node scripts/generate-task-dashboard.mjs",
    "status:start": "cross-env STATUS_TASK=$npm_config_task STATUS_STATE=in_progress STATUS_PERCENT=0 STATUS_ACTIVITY=\"Bắt đầu task\" npm run status:generate"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "cross-env": "^10.0.0"
  }
}
