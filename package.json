{
  "name": "hnlms-workspace",
  "private": true,
  "engines": {
    "node": ">=20.12 <21"
  },
  "workspaces": [
    "apps/*",
    "worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@hnlms/web -- -p 3100",
    "dev:web": "npm run dev --workspace=@hnlms/web -- -p 3100",
    "dev:api": "npm run dev --workspace=@hnlms/api",
    "dev:worker": "npm run dev --workspace=@hnlms/worker",
    "build": "npm run build --workspace=@hnlms/web",
    "typecheck": "npm run typecheck --workspace=@hnlms/web && npm run typecheck --workspace=@hnlms/api && npm run typecheck --workspace=@hnlms/worker && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check \"apps/**/src/**/*.{ts,tsx,js,mjs,css,json,md}\" \"worker/src/**/*.{ts,js,json,md}\" \"packages/**/src/**/*.{ts,tsx,json,md}\" \"tests/**/*.{ts,tsx}\" \"*.{json,md,mjs}\" \"docs/development/**/*.{md,json}\" \"infra/**/*.{md,json}\"",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "status:generate": "node scripts/update-project-status.mjs && node scripts/generate-task-dashboard.mjs",
    "status:start": "cross-env STATUS_TASK=$npm_config_task STATUS_STATE=in_progress STATUS_PERCENT=0 STATUS_ACTIVITY=\"Bắt đầu task\" npm run status:generate"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.58.2",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7",
    "cross-env": "^10.0.0"
  }
}
