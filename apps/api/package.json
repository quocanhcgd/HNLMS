{
  "name": "@hnlms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-api-dev.cjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node --test",
    "db:generate": "drizzle-kit generate --config=../../drizzle.config.ts",
    "db:migrate": "tsx src/database/migrate.ts --run",
    "db:seed:competency": "tsx src/database/seed-competency-profiles.ts",
    "db:seed:academic": "tsx src/database/seed-academic-registry.ts --run"
  },
  "dependencies": {
    "@hnlms/config": "0.1.0",
    "@hnlms/domain-contracts": "0.1.0",
    "@hnlms/test-fixtures": "0.1.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@hnlms/integration-adapters": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
