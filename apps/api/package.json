{
  "name": "@hnlms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-api-dev.cjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node --test",
    "db:generate": "drizzle-kit generate --config=../../drizzle.config.ts",
    "db:migrate": "tsx src/database/migrate.ts --run",
    "db:seed:competency": "tsx src/database/seed-competency-profiles.ts",
    "db:seed:academic": "tsx src/database/seed-academic-registry.ts --run"
  },
  "dependencies": {
    "@hnlms/config": "0.1.0",
    "@hnlms/domain-contracts": "0.1.0",
    "@hnlms/test-fixtures": "0.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@hnlms/integration-adapters": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
