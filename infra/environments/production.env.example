# Copy to /etc/hn-lms/hn-lms.env, replace every placeholder and chmod 0600.
NODE_ENV=production
WEB_ORIGIN=https://lms.example.com
API_PORT=4000
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
REDIS_URL=redis://REPLACE_HOST:6379
OBJECT_STORAGE_ENDPOINT=https://storage.example.com
OBJECT_STORAGE_BUCKET=REPLACE_BUCKET
OBJECT_STORAGE_ACCESS_KEY=REPLACE_SECRET
OBJECT_STORAGE_SECRET_KEY=REPLACE_SECRET
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
LOG_LEVEL=info
