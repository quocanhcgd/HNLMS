{
  "profile": "native-local",
  "services": {
    "postgres": { "host": "localhost", "port": 5432, "required": true, "env": "DATABASE_URL" },
    "redis": { "host": "localhost", "port": 6379, "required": true, "env": "REDIS_URL" },
    "objectStorage": { "host": "localhost", "port": 9000, "required": false, "env": "OBJECT_STORAGE_ENDPOINT" }
  },
  "sandboxAdapters": ["payment", "meeting", "accounting", "ai"],
  "secrets": "inject through .env.local or the deployment secret store; never commit credentials"
}
